{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otrocad",
  "compatibility_date": "2026-11-01",
  "main": "./workers/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "ARQUI_RATE_LIMIT",
      "namespace_id": "3017",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
