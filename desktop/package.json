{
  "name": "otrocad-desktop",
  "version": "0.6.1",
  "private": true,
  "description": "OtroCAD Windows 0.6.1: motor arquitectónico local, tipologías, CAD/DWG y bibliotecas sin conexión ni créditos",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.otrocad.desktop",
    "productName": "OtroCAD",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "build/otrocad.ico",
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/otrocad.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OtroCAD-Windows-0.6.1-experimental-Setup.${ext}",
      "installerIcon": "build/otrocad.ico",
      "uninstallerIcon": "build/otrocad.ico",
      "installerHeaderIcon": "build/otrocad.ico",
      "shortcutName": "OtroCAD"
    }
  }
}
