<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="OtroCAD Nativo · Prueba"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">
        <activity android:name="com.otrocad.app.MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter android:label="Abrir dibujo en OtroCAD Nativo">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:mimeType="application/dxf"/>
                <data android:mimeType="application/json"/>
                <data android:mimeType="application/octet-stream"/>
                <data android:mimeType="application/acad"/>
                <data android:mimeType="image/vnd.dxf"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
